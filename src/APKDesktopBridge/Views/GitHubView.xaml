  <UserControl x:Class="APKDesktopBridge.Views.GitHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <StackPanel>
            <TextBlock Text="GitHub APK Browser" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Enter a GitHub repository owner and name to discover APK release assets." Foreground="#94A3B8" Margin="0,4,0,16"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtOwner" Grid.Column="0" Text="owner" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtRepo" Grid.Column="1" Text="repository" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Find APKs" Click="OnSearchGitHubClick"/>
            </Grid>

            <ListBox x:Name="LstAssets" Height="260" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" DisplayMemberPath="FileName"/>
            <Button Content="Download &amp; Install Selected APK" Click="OnDownloadAssetClick" Margin="0,16,0,0" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtStatus" Foreground="#38BDF8" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
