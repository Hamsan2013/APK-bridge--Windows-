  <UserControl x:Class="APKDesktopBridge.Views.FileTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnAnyFileDrop"
             DragOver="OnAnyFileDragOver">
    <Grid Margin="32" Background="Transparent" AllowDrop="True" Drop="OnAnyFileDrop" DragOver="OnAnyFileDragOver">
        <StackPanel>
            <TextBlock Text="Emulator File Transfer" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Drag and drop any file (AI models, .gguf, images, ZIPs, documents) into your Android Emulator's internal storage." Foreground="#94A3B8" Margin="0,4,0,20"/>

            <Border Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Destination Path Inside Android Emulator:" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtAndroidPath" Grid.Column="0" Text="/sdcard/Download/" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Downloads" Click="PresetDownloads_Click" Margin="0,0,6,0" Background="#334155"/>
                        <Button Grid.Column="2" Content="Documents" Click="PresetDocuments_Click" Background="#334155"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="12" Background="#1E293B" Padding="40"
                    AllowDrop="True" Drop="OnAnyFileDrop" DragOver="OnAnyFileDragOver">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Drag &amp; Drop Any File(s) Here to Send to Emulator" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Or click below to pick files from Windows File Explorer" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                    <Button Content="Browse Any File to Send" Click="OnBrowseFilesClick" Width="220"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtTransferStatus" FontSize="14" Foreground="#10B981" FontWeight="SemiBold" Margin="0,20,0,0" TextWrapping="Wrap"/>
            <ListBox x:Name="LstTransferLog" Height="160" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
