  <UserControl x:Class="APKDesktopBridge.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <StackPanel>
            <TextBlock Text="Installed App Library" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Previously installed Android applications." Foreground="#94A3B8" Margin="0,4,0,16"/>

            <ListBox x:Name="LstInstalled" Height="320" Background="#1E293B" Foreground="#F8FAFC" DisplayMemberPath="Name"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Launch in Landscape" Click="OnLaunchClick" Margin="0,0,12,0"/>
                <Button Content="Uninstall" Click="OnUninstallClick" Background="#DC2626"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
