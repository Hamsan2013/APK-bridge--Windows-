  <UserControl x:Class="APKDesktopBridge.Views.RuntimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <StackPanel>
            <TextBlock Text="Android Runtime &amp; Display Manager" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Provision the official Android SDK, start the x86_64 Tablet Emulator, and force Landscape mode." Foreground="#94A3B8" Margin="0,4,0,20"/>

            <Border Background="#1E293B" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="TxtRuntimeState" Text="Checking Android SDK state..." FontSize="15" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Download Android SDK Tools" Click="OnSetupSdkClick" Margin="0,0,12,0"/>
                        <Button Content="Start Emulator (1280×720 Landscape)" Click="OnLaunchEmulatorClick" Background="#10B981"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
