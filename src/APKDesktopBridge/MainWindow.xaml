  <Window x:Class="APKDesktopBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APK Desktop Bridge" Height="680" Width="1080"
        Background="#0F172A" Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <TextBlock Text="APK Desktop Bridge" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Android Local AI Runner" FontSize="12" Foreground="#38BDF8" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Content="Home Dashboard" Click="NavHome_Click" Margin="0,4" Background="Transparent" HorizontalContentAlignment="Left"/>
                    <Button Content="Local File Sideload" Click="NavLocal_Click" Margin="0,4" Background="Transparent" HorizontalContentAlignment="Left"/>
                    <Button Content="GitHub Browser" Click="NavGitHub_Click" Margin="0,4" Background="Transparent" HorizontalContentAlignment="Left"/>
                    <Button Content="Direct URL Installer" Click="NavDirect_Click" Margin="0,4" Background="Transparent" HorizontalContentAlignment="Left"/>
                    <Button Content="App Library" Click="NavLibrary_Click" Margin="0,4" Background="Transparent" HorizontalContentAlignment="Left"/>
                    <Button Content="Runtime &amp; Display" Click="NavRuntime_Click" Margin="0,4" Background="Transparent" HorizontalContentAlignment="Left"/>
                    <Button Content="Settings" Click="NavSettings_Click" Margin="0,4" Background="Transparent" HorizontalContentAlignment="Left"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#0F172A" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="TxtAdbStatus" Text="ADB: Checking..." FontSize="12" Foreground="#10B981" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtDisplayMode" Text="Display: Landscape 1280×720" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Dynamic View Host -->
        <ContentControl x:Name="MainContent" Grid.Column="1"/>
    </Grid>
</Window>
